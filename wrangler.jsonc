{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rzl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Same origin for SPA + API: the Worker runs first only for /api/*,
  // everything else is a static asset with SPA fallback to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "development"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rzl-db",
      // Placeholder for local dev; replace with the real id from `wrangler d1 create rzl-db` before deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Login attempts per client IP (worker/lib/auth.ts).
  "ratelimits": [{ "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "observability": { "enabled": true }
}
